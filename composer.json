{
    "name": "alecgarcia/laravel-ai-vertex",
    "description": "A Google Vertex AI driver for the Laravel AI SDK, with Gemini text over generateContent or the Interactions API, and embeddings.",
    "keywords": [
        "laravel",
        "ai",
        "vertex",
        "gemini",
        "google-cloud"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/ai": "^1.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/cache": "^12.0||^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "AlecGarcia\\AiVertex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlecGarcia\\AiVertex\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlecGarcia\\AiVertex\\VertexServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
